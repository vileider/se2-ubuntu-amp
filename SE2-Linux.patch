+    private static void AddHeadlessPlatform(EngineBuilder engine, GameApp app)
+    {
+        if (OperatingSystem.IsLinux())
+        {
+            // Pulsar may compile plugins in memory. Use the assembly of the active platform
+            // provider so these are the same component types that LinuxCompat indexed.
+            var provider = app.PlatformCore.Http?.GetType().Assembly;
+            var system = provider?.GetType("ClientPlugin.Platform.LinuxSystemEngineComponent");
+            var memory = provider?.GetType("ClientPlugin.Platform.LinuxMemoryEngineComponent");
+            if (system == null || memory == null)
+                throw new InvalidOperationException("Headless Linux requires the system and memory components from the active Pulsar LinuxCompat2 provider.");
+            engine.Add(new EntityBuilder.ComponentBuildInfo { Type = system });
+            engine.Add(new EntityBuilder.ComponentBuildInfo { Type = memory });
+            return;
+        }
+
+        Add(engine, "VRage.Platform.Windows", "Keen.VRage.Platform.Windows.EngineComponents.WinPlatformEngineComponent");
+        Add(engine, "VRage.Platform.Windows", "Keen.VRage.Platform.Windows.EngineComponents.WinSystemEngineComponent");
+        Add(engine, "VRage.Platform.Windows", "Keen.VRage.Platform.Windows.EngineComponents.WinMemoryEngineComponent");
+    }

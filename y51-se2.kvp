Meta.DisplayName=Space Engineers 2 Online (Y51)
Meta.Description=Linux x64, SE2 4.0.0.3169, Y51 0.18.4
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=KNT
Meta.URL=https://se2-online.yellow51.dev/
Meta.DisplayImageSource=steam:1133870
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ApplicationPort1}
Meta.ConfigManifest=y51-se2config.json
Meta.MetaConfigManifest=y51-se2metaconfig.json
Meta.ConfigRoot=y51-se2.kvp
Meta.SpecificDockerImage=local/se2-y51-amp:0.18.4
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=Wymaga obrazu AMP z .NET 10 i biblioteką Steam dla Linux x64.
Meta.NoCommercialUsage=True
Meta.MinAMPVersion=2.5.1.8
Meta.ConfigVersion=2
Meta.AppConfigId=78d25187-fbf8-41fc-bb5b-9de7f34ab7d4
App.DisplayName=Space Engineers 2 Online
App.RootDir=./SpaceEngineers2/
App.BaseDirectory=./SpaceEngineers2/
App.WorkingDir=.
App.ExecutableLinux=/usr/bin/python3
App.CommandLineArgs=-u /opt/se2-amp/service.py {{$ApplicationPort1}} {{$ApplicationPort2}}
App.AppSettings={}
App.EnvironmentVariables={"SE2_SESSION_NAME":"{{SessionName}}","SE2_WORLD_NAME":"{{WorldName}}","SE2_START_CONTENT":"{{StartContent}}","SE2_PASSWORD":"{{ServerPassword}}","SE2_MAX_PLAYERS":"{{$MaxUsers}}","SE2_SAVE_INTERVAL":"{{SaveInterval}}","SE2_ADVERTISE":"{{Advertise}}"}
App.ExitMethod=String
App.ExitString=stop now
App.ExitTimeout=240
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UseLinuxIOREDIR=False
App.SupportsLiveSettingsChanges=False
App.SupportsUniversalSleep=False
App.Ports=[{"Protocol":"UDP","Port":27016,"Ref":"ApplicationPort1","Name":"Gra","Description":"Dołączanie przez Direct connect"},{"Protocol":"UDP","Port":27017,"Ref":"ApplicationPort2","Name":"Steam query","Description":"Wymagany port gry + 1"}]
App.PrimaryApplicationPortRef=ApplicationPort1
App.UniversalSleepSteamQueryPortRef=ApplicationPort2
App.MaxUsers=8
App.AdminMethod=STDIO
App.UpdateSources=[]
App.PreStartStages=[]
App.ForceUpdate=False
App.ApplicationReadyMode=RegexMatch
App.SmartExcludeSupported=False
Console.AppReadyRegex=^SE2_HOSTING_READY$
Console.UserJoinRegex=^SE2_PLAYER_JOIN (?<userid>[0-9]+) (?<username>.+)$
Console.UserLeaveRegex=^SE2_PLAYER_LEAVE (?<userid>[0-9]+) (?<username>.+)$
